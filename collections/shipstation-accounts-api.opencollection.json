{
  "opencollection": "1.0.0",
  "info": {
    "name": "ShipStation V1 Accounts API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ssapi.shipstation.com/accounts/listtags"
          },
          "docs": "Lists all tags defined for this account."
        },
        {
          "info": {
            "name": "Create Tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://ssapi.shipstation.com/accounts/createtag",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new tag that can be applied to orders."
        }
      ]
    }
  ],
  "bundled": true
}